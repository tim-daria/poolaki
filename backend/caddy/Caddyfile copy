# Caddyfile

poolaki.localhost {                          # or domain name

    # API requests → Django
    handle /api/* {
        reverse_proxy backend:8000
    }

    # Django admin
    handle /admin/* {
        reverse_proxy backend:8000
    }

    # Django static/media files
    handle /static/* {
        reverse_proxy backend:8000
    }

    handle /media/* {
        reverse_proxy backend:8000
    }

    # Everything else → React
    handle {
        reverse_proxy frontend:5173
    }

	# testing django auth
    handle /secret/* {
        reverse_proxy backend:8000
    }

}
