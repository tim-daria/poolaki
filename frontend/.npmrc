# ── Supply-chain hardening ────────────────────────────────────────────────────
# Both settings below exist because of the Aug 2026 "Shai-Hulud" npm worm, which
# compromised keyv/flat-cache/cacheable and ~444 packages via worm propagation.

ignore-scripts=true

# Only install versions that have been public for at least 7 days. 
#
# To take a genuinely urgent security patch sooner, override per-command rather
# than lowering this: `npm install <pkg> --min-release-age=0`
#
# Doesn't change packages locked in the lockfile!
min-release-age=7

# Turn the `engines` field in package.json into a hard requirement rather than a
# warning. This exists to protect the setting above: `min-release-age` is npm 11+
# only, and older npm reads the key from this file and reports it via
# `npm config get` while the installer ignores it entirely. 
#
# Note this also enforces the `engines` of every dependency, not just ours, so a
# dep declaring an incompatible range will now fail the install instead of
# warning. Verified working on Node 24 / npm 11.17 locally, in CI, and in the
# node:24-alpine image.
engine-strict=true
